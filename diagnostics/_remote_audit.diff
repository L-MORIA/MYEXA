+    MAX_PDF_PAGES = 50
+
+    # Source language used when translating the user query.
+    SOURCE_LANGUAGE = os.getenv("SOURCE_LANGUAGE", "ru")
+
+    # Registry of supported languages. Each entry carries the UI label shown on
