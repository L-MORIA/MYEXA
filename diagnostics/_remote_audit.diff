+    RELEVANCE_THRESHOLD = 0.3
     OCR_ENABLED = True
     TESSERACT_PATH = os.getenv("TESSERACT_PATH", "tesseract")
+    # Upload / OCR abuse limits (the endpoints are unauthenticated).
