 import os
+import logging
 from dotenv import load_dotenv
 
 load_dotenv()
 
+logging.basicConfig(
+    level=os.getenv("LOG_LEVEL", "INFO"),
+    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
+)
+
+
+def _get_db_path():
+    path = os.getenv("DATABASE_PATH", "./database/myexa.db")
+    if not os.path.isabs(path):
+        base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        # Strip only a leading "./" (or ".\") — str.lstrip("./") would also
+        # eat leading dots from names like ".hidden/db.sqlite".
+        cleaned = path.replace("\\", "/")
+        if cleaned.startswith("./"):
+            cleaned = cleaned[2:]
+        path = os.path.join(base_dir, cleaned)
+    return os.path.normpath(path)
+
+
+def _parse_port() -> int:
+    raw = os.getenv("PORT", "3005")
+    try:
+        return int(raw)
+    except (ValueError, TypeError):
+        print(f"WARNING: Invalid PORT '{raw}', falling back to 3005")
+        return 3005
+
+
