EXA_API_KEY=your_api_key_here
SOURCE_LANGUAGE=ru
DATABASE_PATH=./database/myexa.db
LOG_LEVEL=INFO
PORT=3005
# Bind address. 127.0.0.1 = local only (recommended);
# set 0.0.0.0 only if you need LAN access to the (unauthenticated) API.
HOST=127.0.0.1
# Browser origins allowed to call the API (CORS), comma-separated.
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
